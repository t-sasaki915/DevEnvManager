cabal-version: 2.2

name:           DevEnvManager
version:        0.1.0.0
description:    Please see the README on GitHub at <https://github.com/t-sasaki915/DevEnvManager#readme>
homepage:       https://github.com/t-sasaki915/DevEnvManager#readme
bug-reports:    https://github.com/t-sasaki915/DevEnvManager/issues
author:         Toma Sasaki
maintainer:     netst915@gmail.com
copyright:      2026 Toma Sasaki
license:        MIT
license-file:   LICENSE
build-type:     Simple
extra-source-files:
    README.md

source-repository head
  type: git
  location: https://github.com/t-sasaki915/DevEnvManager

library
  exposed-modules:
      Lib
  other-modules:
      Paths_DevEnvManager
  autogen-modules:
      Paths_DevEnvManager
  hs-source-dirs:
      src
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints
  build-depends:
      base >=4.7 && <5
  default-language: Haskell2010

executable DevEnvManager
  main-is: Main.hs
  other-modules:
      Paths_DevEnvManager
  autogen-modules:
      Paths_DevEnvManager
  hs-source-dirs:
      app
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      DevEnvManager
    , base >=4.7 && <5
  default-language: Haskell2010

test-suite DevEnvManager-test
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  other-modules:
      Paths_DevEnvManager
  autogen-modules:
      Paths_DevEnvManager
  hs-source-dirs:
      test
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      DevEnvManager
    , base >=4.7 && <5
  default-language: Haskell2010
